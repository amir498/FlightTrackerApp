<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    tools:context=".presentation.activities.beforeHome.SplashActivity">

    <ImageView
        android:id="@+id/iv_splash"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/iv_splash_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/live_flight_track"
        style="@style/sfb20p"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-10dp"
        android:text="@string/live_flight_track"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.65"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <ImageView
        android:id="@+id/iv_splash_line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:src="@drawable/iv_splash_line"
        app:layout_constraintEnd_toEndOf="@+id/live_flight_track"
        app:layout_constraintStart_toStartOf="@+id/live_flight_track"
        app:layout_constraintTop_toBottomOf="@+id/live_flight_track" />

    <TextView
        android:id="@+id/live_flight_track2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:text="@string/flights"
        style="@style/sfr13s"
        android:layout_marginStart="@dimen/_6sdp"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintEnd_toStartOf="@+id/iv_splash_dots1"
        app:layout_constraintStart_toStartOf="@+id/iv_splash_line"
        app:layout_constraintTop_toBottomOf="@+id/iv_splash_line"
        />

    <ImageView
        android:layout_width="@dimen/_6sdp"
        android:layout_height="@dimen/_6sdp"
        android:src="@drawable/iv_splash_dots"
        android:id="@+id/iv_splash_dots1"
        android:layout_marginStart="@dimen/_3sdp"
        android:layout_marginEnd="@dimen/_3sdp"
        app:layout_constraintStart_toEndOf="@+id/live_flight_track2"
        app:layout_constraintEnd_toStartOf="@+id/live_flight_track22"
        app:layout_constraintTop_toTopOf="@+id/live_flight_track2"
        app:layout_constraintBottom_toBottomOf="@+id/live_flight_track2"/>

    <TextView
        android:id="@+id/live_flight_track22"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/radar"
        style="@style/sfr13s"
        app:layout_constraintEnd_toStartOf="@+id/iv_splash_dots2"
        app:layout_constraintStart_toEndOf="@+id/iv_splash_dots1"
        app:layout_constraintTop_toTopOf="@+id/live_flight_track2"
        />

    <ImageView
        android:layout_width="@dimen/_6sdp"
        android:layout_height="@dimen/_6sdp"
        android:src="@drawable/iv_splash_dots"
        android:id="@+id/iv_splash_dots2"
        android:layout_marginStart="@dimen/_3sdp"
        android:layout_marginEnd="@dimen/_3sdp"
        app:layout_constraintStart_toEndOf="@+id/live_flight_track22"
        app:layout_constraintEnd_toStartOf="@+id/live_flight_track23"
        app:layout_constraintTop_toTopOf="@+id/live_flight_track2"
        app:layout_constraintBottom_toBottomOf="@+id/live_flight_track2"/>

    <TextView
        android:id="@+id/live_flight_track23"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/details"
        style="@style/sfr13s"
        android:layout_marginEnd="@dimen/_6sdp"
        app:layout_constraintStart_toEndOf="@+id/iv_splash_dots2"
        app:layout_constraintEnd_toEndOf="@+id/iv_splash_line"
        app:layout_constraintTop_toTopOf="@+id/live_flight_track2"
        />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottiepg"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/loadingText"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/splash_loading" />

    <TextView
        android:id="@+id/loadingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:fontFamily="@font/sf_pro_display_medium"
        android:text="@string/may_contain_ad"
        android:textColor="@color/text_color_s"
        android:textSize="12sp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/adContainerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/adContainerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>